<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
    <PackageReference Include="MonoGame.Extended" Version="5.3.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Core\EngineFrameContext.cs" />
    <Compile Include="Core\ExtendedGameHost.cs" />
    <Compile Include="Core\InputBridge.cs" />
    <Compile Include="Core\TiledMapRuntime.cs" />
  </ItemGroup>
</Project>
