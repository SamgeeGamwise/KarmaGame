
#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:DesktopGL
/config:
/profile:Reach
/compress:False

#-------------------------------- References --------------------------------#

/reference:../pipeline-references/MonoGame.Extended.Content.Pipeline.dll

#---------------------------------- Content ---------------------------------#

#begin Characters/NPCs/ShopClerk.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyColor=255,0,255,255
/processorParam:ColorKeyEnabled=True
/processorParam:GenerateMipmaps=False
/processorParam:PremultiplyAlpha=True
/processorParam:ResizeToPowerOfTwo=False
/processorParam:MakeSquare=False
/processorParam:TextureFormat=Color
/build:Characters/NPCs/ShopClerk.png;Characters/NPCs/ShopClerk

#begin Characters/Person2.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyColor=255,0,255,255
/processorParam:ColorKeyEnabled=True
/processorParam:GenerateMipmaps=False
/processorParam:PremultiplyAlpha=True
/processorParam:ResizeToPowerOfTwo=False
/processorParam:MakeSquare=False
/processorParam:TextureFormat=Color
/build:Characters/Person2.png

#begin Maps/GameMap.tmx
/importer:TiledMapImporter
/processor:TiledMapProcessor
/build:Maps/GameMap.tmx

#begin Maps/HospitalInterior.tmx
/importer:TiledMapImporter
/processor:TiledMapProcessor
/build:Maps/HospitalInterior.tmx

#begin Maps/Modern Exterior Master Tileset.tsx
/importer:TiledMapTilesetImporter
/processor:TiledMapTilesetProcessor
/build:Maps/Modern Exterior Master Tileset.tsx

#begin Maps/Modern Exterior Master Tileset part 2.tsx
/importer:TiledMapTilesetImporter
/processor:TiledMapTilesetProcessor
/build:Maps/Modern Exterior Master Tileset part 2.tsx

#begin Maps/Modern Exterior Master Tileset part 3.tsx
/importer:TiledMapTilesetImporter
/processor:TiledMapTilesetProcessor
/build:Maps/Modern Exterior Master Tileset part 3.tsx

#begin Maps/Modern Exterior Master Tileset part 4.tsx
/importer:TiledMapTilesetImporter
/processor:TiledMapTilesetProcessor
/build:Maps/Modern Exterior Master Tileset part 4.tsx

#begin Maps/Modern Exterior Master Tileset part 5.tsx
/importer:TiledMapTilesetImporter
/processor:TiledMapTilesetProcessor
/build:Maps/Modern Exterior Master Tileset part 5.tsx

#begin Maps/Modern Exterior Master Tileset part 6.tsx
/importer:TiledMapTilesetImporter
/processor:TiledMapTilesetProcessor
/build:Maps/Modern Exterior Master Tileset part 6.tsx

#begin Maps/Modern Interior Master Tileset.tsx
/importer:TiledMapTilesetImporter
/processor:TiledMapTilesetProcessor
/build:Maps/Modern Interior Master Tileset.tsx

#begin Maps/Modern Interior Master Tileset part 2.tsx
/importer:TiledMapTilesetImporter
/processor:TiledMapTilesetProcessor
/build:Maps/Modern Interior Master Tileset part 2.tsx

#begin UI/UIFont.spritefont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Compressed
/build:UI/UIFont.spritefont

