{
  "window": {
    "virtualWidth": 640,
    "virtualHeight": 360,
    "backBufferWidth": 1280,
    "backBufferHeight": 720,
    "allowUserResizing": true
  },
  "render": {
    "clearColor": { "r": 24, "g": 29, "b": 38 }
  },
  "input": {
    "bindings": [
      { "action": "move_left", "key": "A" },
      { "action": "move_right", "key": "D" },
      { "action": "move_up", "key": "W" },
      { "action": "move_down", "key": "S" },
      { "action": "run", "key": "LeftShift" },
      { "action": "action", "key": "E" },
      { "action": "toggle_debug", "key": "F3" },
      { "action": "exit", "key": "Escape" }
    ]
  },
  "scene": {
    "startingMapAssetName": "Town",
    "actionInputActionName": "action",
    "debugToggleInputActionName": "toggle_debug",
    "exitInputActionName": "exit",
    "cameraZoom": 1.5,
    "portalTransitionCooldownSeconds": 0.35,
    "drawPortalDebugOverlay": true,
    "portals": [
      {
        "sourceMapAssetName": "Town",
        "triggerObjectName": "DoorToHouse",
        "targetMapAssetName": "HouseInterior",
        "targetSpawnObjectName": "HouseFromTown"
      },
      {
        "sourceMapAssetName": "HouseInterior",
        "triggerObjectName": "DoorToTown",
        "targetMapAssetName": "Town",
        "targetSpawnObjectName": "TownFromHouse"
      }
    ]
  },
  "player": {
    "spriteSheetAssetName": "Person2",
    "targetHeightInPixels": 24,
    "walkFramesPerSecond": 8.0,
    "moveSpeed": 75.0,
    "runSpeed": 100.0,
    "collisionWidth": 10,
    "collisionHeight": 9,
    "collisionBottomInset": 3,
    "doorInteractionWidth": 9,
    "doorInteractionHeight": 17
  },
  "dayNight": {
    "minutesPerDay": 1440,
    "startMinutes": 360,
    "minutesPerTick": 60,
    "secondsPerTick": 5.0,
    "clockPanelPadding": 8,
    "tintTimeline": [
      { "minutes": 0, "color": { "r": 24, "g": 32, "b": 62 }, "alpha": 0.44 },
      { "minutes": 120, "color": { "r": 12, "g": 18, "b": 40 }, "alpha": 0.56 },
      { "minutes": 300, "color": { "r": 34, "g": 42, "b": 70 }, "alpha": 0.30 },
      { "minutes": 360, "color": { "r": 255, "g": 214, "b": 170 }, "alpha": 0.16 },
      { "minutes": 720, "color": { "r": 255, "g": 255, "b": 255 }, "alpha": 0.04 },
      { "minutes": 1080, "color": { "r": 255, "g": 188, "b": 140 }, "alpha": 0.14 },
      { "minutes": 1320, "color": { "r": 42, "g": 50, "b": 86 }, "alpha": 0.32 }
    ]
  }
}
